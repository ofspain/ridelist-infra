version: "3.8"

services:

  postgres:
    image: postgres:15-alpine
    container_name: {{ postgres_container }}
    restart: always

    environment:
      POSTGRES_DB: ${DB_NAME}
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      PGDATA: /var/lib/postgresql/data

    volumes:
      - {{ postgres_data_dir }}:/var/lib/postgresql/data
      - {{ application_root }}/db-init:/docker-entrypoint-initdb.d

    networks:
      - {{ docker_network_name }}

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

  backend:
    image: ${ECR_BACKEND_IMAGE}
    container_name: {{ backend_container }}
    restart: always

    environment:
      DB_HOST: postgres
      DB_PORT: {{ postgres_port }}
      DB_NAME: ${DB_NAME}
      DB_USERNAME: ${DB_USERNAME}
      DB_PASSWORD: ${DB_PASSWORD}

      JWT_SECRET: ${JWT_SECRET}
      JWT_EXPIRATION: ${JWT_EXPIRATION}
      JWT_REFRESH_EXPIRATION: ${JWT_REFRESH_EXPIRATION}

      AWS_ACCESS_KEY: ${AWS_ACCESS_KEY}
      AWS_SECRET_KEY: ${AWS_SECRET_KEY}
      AWS_REGION: ${AWS_REGION}
      AWS_S3_BUCKET: ${AWS_S3_BUCKET}

      EMAIL_SENDER: ${EMAIL_SENDER}
      EMAIL_FROM: ${EMAIL_FROM}
      EMAIL_FROM_NAME: ${EMAIL_FROM_NAME}

      SMTP_HOST: ${SMTP_HOST}
      SMTP_PORT: ${SMTP_PORT}
      SMTP_USERNAME: ${SMTP_USERNAME}
      SMTP_PASSWORD: ${SMTP_PASSWORD}

      FRONTEND_BASE_URL: ${FRONTEND_BASE_URL}

      IMAGE_MIN_COUNT: ${IMAGE_MIN_COUNT}
      IMAGE_MAX_COUNT: ${IMAGE_MAX_COUNT}
      IMAGE_MAX_SIZE_MB: ${IMAGE_MAX_SIZE_MB}

      SPRING_PROFILES_ACTIVE: docker

      JAVA_OPTS: "-Xmx350m -Xms256m -XX:+UseContainerSupport"

    depends_on:
      postgres:
        condition: service_healthy

    networks:
      - {{ docker_network_name }}

  frontend:
    image: ${ECR_FRONTEND_IMAGE}
    container_name: {{ frontend_container }}
    restart: always

    networks:
      - {{ docker_network_name }}

  nginx:
    image: nginx:alpine
    container_name: {{ nginx_container }}
    restart: always

    ports:
      - "80:80"
      - "443:443"

    volumes:
      - {{ application_root }}/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ application_root }}/nginx/nginx-redirect.conf:/etc/nginx/conf.d/redirect.conf:ro
      - {{ application_root }}/nginx/frontend.conf:/etc/nginx/conf.d/frontend.conf:ro
      - {{ application_root }}/nginx/backend.conf:/etc/nginx/conf.d/backend.conf:ro

      - /etc/letsencrypt:/etc/letsencrypt:ro
      - /var/www/certbot:/var/www/certbot:ro

    depends_on:
      backend:
        condition: service_started

      frontend:
        condition: service_started

    networks:
      - {{ docker_network_name }}

networks:
  {{ docker_network_name }}:
    name: {{ docker_network_name }}
    driver: bridge